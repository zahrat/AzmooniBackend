DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_prisma

# Use long, independent random secrets outside development.
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-refresh-secret

# Token lifetimes in seconds (defaults: 14 days and 1 day).
JWT_ACCESS_TTL_SECONDS=1209600
JWT_REFRESH_TTL_SECONDS=86400

# Optional bootstrap admin. Both values are required when either is set.
# The password is hashed before it is stored in the User table.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Admin
