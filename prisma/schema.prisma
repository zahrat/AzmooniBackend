// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  EXPIRED
}

model User {
  id               Int      @id @default(autoincrement())
  phone            String   @unique
  name             String?
  password         String?
  role             UserRole @default(USER)
  refreshTokenHash String?
  createdAt        DateTime @default(now())

  answers           UserAnswer[]
  favoriteQuestions FavoriteQuestion[]
  bookPurchases     UserBookPurchase[]
  payments          Payment[]
}

model OtpChallenge {
  phone      String   @id
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  description String?
  priceToman  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters  Chapter[]
  purchases UserBookPurchase[]
  payments  Payment[]
}

model Chapter {
  id                Int      @id @default(autoincrement())
  bookId            Int
  title             String
  order             Int
  isFree            Boolean  @default(false)
  nextQuestionOrder Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  book      Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([bookId, order])
}

model UserBookPurchase {
  userId Int
  bookId Int
  paidAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([userId, bookId])
}

model Payment {
  id             Int           @id @default(autoincrement())
  userId         Int
  bookId         Int
  amountToman    Int
  status         PaymentStatus @default(PENDING)
  authority      String?       @unique
  refId          String?       @unique
  paymentUrl     String?
  activeKey      String?       @unique
  cardPan        String?
  cardHash       String?
  feeToman       Int?
  failureCode    Int?
  verifyAttempts Int           @default(0)
  lastVerifiedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  expiresAt      DateTime
  paidAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([bookId, status])
  @@index([userId, bookId, status, expiresAt])
}

model Question {
  id            Int      @id @default(autoincrement())
  chapterId     Int
  order         Int
  text          String
  source        String?
  imageUrl      String?
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chapter           Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  answers           UserAnswer[]
  favoriteQuestions FavoriteQuestion[]

  @@unique([chapterId, order])
}

model UserAnswer {
  id             Int      @id @default(autoincrement())
  userId         Int
  questionId     Int
  selectedOption String
  isCorrect      Boolean
  createdAt      DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model FavoriteQuestion {
  userId     Int
  questionId Int
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
}
